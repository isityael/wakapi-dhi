{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>isityael/infra//.github/renovate/base.json",
    "config:best-practices",
    ":preserveSemverRanges"
  ],
  "enabledManagers": [
    "woodpecker",
    "gomod",
    "dockerfile",
    "npm",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^dhi\\/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "GOLANG_REFERENCE:\\s*(?<depName>dhi\\.io/golang):(?<currentValue>[^@\\s]+)",
        "uses:\\s*(?<depName>dhi\\.io/golang):(?<currentValue>[^@\\s]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "The upstream Wakapi module is replaced by this checkout; source updates are merged from upstream tags",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/muety/wakapi"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "automerge": true,
      "matchUpdateTypes": [
        "patch",
        "minor"
      ]
    },
    {
      "matchManagers": [
        "dockerfile",
        "custom.regex"
      ],
      "labels": [
        "dependencies",
        "docker"
      ]
    },
    {
      "matchManagers": [
        "npm"
      ],
      "labels": [
        "dependencies",
        "frontend"
      ]
    },
    {
      "description": "Reduce abandonment false-positives for stable or low-churn upstream dependencies",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/cespare/xxhash/v2",
        "github.com/dchest/captcha",
        "github.com/emersion/go-sasl",
        "github.com/go-chi/httprate",
        "github.com/gorilla/schema",
        "github.com/gorilla/securecookie",
        "github.com/gorilla/sessions",
        "github.com/mileusna/useragent",
        "github.com/oauth2-proxy/mockoidc",
        "github.com/robfig/cron/v3",
        "github.com/stripe/stripe-go/v76",
        "github.com/swaggo/http-swagger/v2",
        "gorm.io/driver/mysql",
        "gorm.io/driver/postgres",
        "gopkg.in/yaml.v3"
      ],
      "abandonmentThreshold": "5 years"
    },
    {
      "description": "Use container version tags only.",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": false
    },
    {
      "description": "Do not create container digest pins or digest refreshes.",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "enabled": false
    },
    {
      "description": "One reviewed weekly dependency refresh, including majors, charts, images and tooling.",
      "matchPackageNames": [
        "*"
      ],
      "groupName": "weekly dependencies",
      "groupSlug": "weekly-dependencies",
      "groupSingleUpdates": true,
      "minimumGroupSize": 1,
      "additionalBranchPrefix": "",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false,
      "separateMultipleMinor": false,
      "schedule": [
        "* 0-5 * * 1"
      ],
      "automerge": false
    }
  ],
  "pinDigests": false,
  "ignorePresets": [
    "docker:pinDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 0-5 * * 1"
  ],
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "separateMultipleMajor": false,
  "separateMultipleMinor": false,
  "prConcurrentLimit": 1,
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": false
  }
}
